{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": ["nuget"],
  "dependencyDashboard": false,
  "packageRules": [
    {
      "description": "Default cooldown for all NuGet packages",
      "matchDatasources": ["nuget"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "No cooldown for TMW's own packages",
      "matchDatasources": ["nuget"],
      "matchPackageNames": [
        "Aero.Gen",
        "FauCap",
        "FauCapParser",
        "FauFau",
        "ImTool",
        "TMW.Bitter"
      ],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Aero.Gen's Roslyn version sets the minimum compiler for consumers, so only bump it on purpose",
      "matchFileNames": ["Aero/Aero.Gen/Aero.Gen.csproj"],
      "matchPackageNames": ["Microsoft.CodeAnalysis.CSharp"],
      "enabled": false
    }
  ]
}
